{
  "name": "githubster",
  "version": "4.0.0",
  "description": "Track your GitHub followers, unfollowers, and following relationships",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "node scripts/prepare-stars-snapshot.mjs",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "start": "next start",
    "clean": "rm -rf .next",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview --infer-origin-from-routes=false",
    "cf:deploy": "node scripts/check-cloudflare-cache.mjs && opennextjs-cloudflare deploy",
    "cf:smoke": "node --env-file-if-exists=.env.production.local scripts/smoke-cloudflare.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.13",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "wrangler": "4.154.0"
  }
}
