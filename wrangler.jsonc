{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "githubster",
  "account_id": "ddf5893e0154440c11407903199bac99",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  // Proxied DNS records anchor these routes; the former Hetzner origin is removed.
  "routes": [
    { "pattern": "githubster.com/*", "zone_name": "githubster.com" },
    { "pattern": "www.githubster.com/*", "zone_name": "githubster.com" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Retain the historical migration for rollback; the ISR queue is no longer used.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }
  ],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
